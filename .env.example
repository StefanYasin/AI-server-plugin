# --- VMware ESXi / vSphere ---
ESXI_HOST=192.168.1.10
ESXI_USER=root
ESXI_PASSWORD=changeme
ESXI_PORT=443
ESXI_VERIFY_SSL=false

# --- Dell iDRAC / IPMI (hardware sensors) ---
IDRAC_HOST=192.168.1.11
IDRAC_USER=root
IDRAC_PASSWORD=changeme

# --- AI agent (optional) ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Thresholds ---
CPU_WARN=80
CPU_CRIT=95
TEMP_WARN=70
TEMP_CRIT=85
